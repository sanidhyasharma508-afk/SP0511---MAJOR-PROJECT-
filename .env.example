# Campus Automation System (MARVEL) - Environment Configuration Example
# Copy this file to .env and configure values appropriate for your environment.
# NEVER commit your real .env file with sensitive secrets to version control.

# ==============================================================================
# Environment & Server
# ==============================================================================
# Options: development, testing, production
ENV=development
# Must be False in production to avoid exposing tracebacks
DEBUG=True

HOST=127.0.0.1
PORT=8000
API_PREFIX=/api/v1

# ==============================================================================
# Authentication & JWT Security
# ==============================================================================
# REQUIRED IN PRODUCTION: Must be a strong, cryptographically random secret (min 32 characters).
# Generate a secure secret using:
#   python -c "import secrets; print(secrets.token_hex(32))"
#   or: openssl rand -hex 32
# Insecure default placeholders are strictly rejected on production startup.
SECRET_KEY=replace-with-a-secure-random-32-char-key-for-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==============================================================================
# CORS (Cross-Origin Resource Sharing)
# ==============================================================================
# Comma-separated list of allowed frontend origins.
# In production, wildcards ('*') are strictly rejected when credentials are enabled.
# Development defaults to local origins if unset: http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000
ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
ALLOWED_HEADERS=Content-Type,Authorization,Accept,Origin,X-Requested-With

# ==============================================================================
# Database Configuration
# ==============================================================================
# Development: SQLite (default)
DATABASE_URL=sqlite:///./campus_automation.db
# Production: PostgreSQL (recommended for high concurrency)
# DATABASE_URL=postgresql://user:password@localhost:5432/campus_automation
DB_ECHO=False
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ==============================================================================
# Logging Configuration
# ==============================================================================
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# ==============================================================================
# Optional Services (Redis, Celery, Email)
# ==============================================================================
ENABLE_CACHING=False
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=300

ENABLE_BACKGROUND_TASKS=False
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

ENABLE_EMAIL_NOTIFICATIONS=False
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SENDER_EMAIL=noreply@campus.edu
